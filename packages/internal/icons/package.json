{
  "name": "@hyperscal/icons",
  "version": "0.0.0",
  "private": true,
  "description": "A collection of icons",
  "type": "module",
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./icons": {
      "types": "./dist/gen/types.d.ts",
      "import": "./dist/icons.js"
    },
    "./icon.css": "./dist/icon.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "gen": "tsx ./scripts/generator",
    "build": "tsdown && tsc -p tsconfig.json && copy-files-from-to",
    "dev": "concurrently -k -n js,dts -c blue,green \"tsdown --watch --no-clean\" \"tsc -p tsconfig.json --watch --preserveWatchOutput\"",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "react": ">=15.6.1"
  },
  "devDependencies": {
    "@iconify-json/tabler": "1.2.20",
    "@iconify/utils": "^2.3.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.3",
    "copy-files-from-to": "^3.12.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "tsdown": "^0.17.0",
    "tsx": "^4.20.3",
    "typescript": "^5.9.2"
  },
  "copyFiles": [
    {
      "from": "src/gen/icon.css",
      "to": "dist/icon.css"
    }
  ]
}
