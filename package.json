{
  "name": "automation",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.1.3",
  "scripts": {
    "dev": "concurrently --kill-others --names api,web \"pnpm dev:api\" \"pnpm dev:web\"",
    "dev:api": "node server/server.mjs",
    "dev:api:watch": "node --watch server/server.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:sync-catalog": "node server/modules/catalog/sync-catalog.mjs",
    "dev:web": "node server/dev-web.mjs",
    "build": "vite build",
    "preview": "vite preview --port 3110",
    "typecheck": "tsc --noEmit",
    "test:evidence": "tsx packages/internal/test-utils/src/export/evidence-cli.ts"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.99",
    "@ai-sdk/google": "^4.0.114",
    "@ai-sdk/openai": "^4.0.111",
    "@ai-sdk/openai-compatible": "^3.0.87",
    "@hyperscal/icons": "workspace:*",
    "@hyperscal/tailwind-config": "workspace:*",
    "@radix-ui/react-select": "2.1.0",
    "@tanstack/react-query": "^5.85.0",
    "ai": "^7.0.166",
    "dotenv": "^17.2.3",
    "drizzle-orm": "^0.45.4",
    "exceljs": "^4.4.0",
    "express": "^4.21.1",
    "mammoth": "^1.13.0",
    "pdfjs-dist": "^6.3.289",
    "pg": "^8.23.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-markdown": "^10.1.0",
    "react-router": "7.18.5",
    "remark-gfm": "^4.0.1",
    "tailwindcss": "^4.1.11",
    "undici": "^8.12.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.15",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.3",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "concurrently": "^9.0.1",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.20.3",
    "typescript": "^5.9.2",
    "vite": "^8.1.5"
  }
}
