# PostgreSQL connection used by the Automation API and Drizzle migrations.
AUTOMATION_DATABASE_URL=

# Required to encrypt per-browser AI provider keys at rest; generate a random 32-byte base64url value.
AUTOMATION_AGENT_ENCRYPTION_KEY=

# Optional local target override for the BDD runner.
BASE_URL=

# Optional Drive evidence integration. Keep credential values in an ignored .env.local.
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_SERVICE_ACCOUNT_FILE=
GOOGLE_DRIVE_FOLDER_ID=

# Optional Cloudflare R2 evidence integration. When configured, R2 is preferred over Drive.
CLOUDFLARE_R2_ACCOUNT_ID=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET=
CLOUDFLARE_R2_ENDPOINT=

# Optional local web server overrides.
AUTOMATION_WEB_HOST=127.0.0.1
AUTOMATION_WEB_PORT=3110
